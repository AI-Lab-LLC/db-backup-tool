APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Panel's own database
DB_CONNECTION=pgsql
DB_HOST=10.0.0.3
DB_PORT=5432
DB_DATABASE=backup_panel
DB_USERNAME=backup_admin
DB_PASSWORD=

# PostgreSQL connection used for pg_dump / pg_restore / psql
PG_HOST=10.0.0.3
PG_PORT=5432
PG_USER=backup_admin
PG_PASSWORD=
# Directory with pg_dump / pg_restore / psql (empty = use PATH).
# prod: /usr/lib/postgresql/17/bin (server is PG 17; default PATH has client 18)
PG_BIN_DIR=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Recommended in prod (HTTPS only):
# SESSION_SECURE_COOKIE=true

# Comma-separated IPs / CIDRs allowed to reach the panel (incl. login), e.g.
# PANEL_ALLOWED_IPS=203.0.113.10,198.51.100.0/24   (empty = allow all)
PANEL_ALLOWED_IPS=
# Proxies trusted for X-Forwarded-* (default '*' = the immediate peer). Behind
# Cloudflare make sure the origin is only reachable via Cloudflare/nginx, or the
# client IP can be spoofed via X-Forwarded-For.
# TRUSTED_PROXIES=   (keep EMPTY on Forge — nginx already resolves the real client IP from Cloudflare; '*' only if your proxy does not rewrite REMOTE_ADDR)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must stay > RunBackupJob / RunRestoreJob timeout (5400s) and uniqueFor (5600s); default 5700.
# Do NOT set lower, or a long job is picked up a second time by another worker.
# DB_QUEUE_RETRY_AFTER=5700

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Hetzner Object Storage (S3-compatible), region hel1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=hel1
AWS_BUCKET=
AWS_ENDPOINT=https://hel1.your-objectstorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# Temp dir for pg_dump output / restore staging (needs room for the largest dump).
# On Forge use a path OUTSIDE the releases dir so deploys can't remove it, e.g.:
# BACKUP_TMP_DIR=/home/forge/backup-tmp
# (unset = storage/app/tmp)

# Opt-in failure / stale-backup e-mail alerts (always logged regardless).
# Requires a working MAIL_* mailer; leave empty to only log.
BACKUP_ALERT_EMAIL=

# Seeded admin account (AdminUserSeeder)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
